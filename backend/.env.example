# ============================================================
# FastAPI (uvicorn)
# ============================================================
API_HOST=0.0.0.0
API_PORT=5000
DATABASE_PATH=sensor_data.db
STORAGE_WARNING_PERCENT=85
STORAGE_CLEANUP_TARGET_PERCENT=80
STORAGE_CLEANUP_BATCH_SIZE=10000
STORAGE_MIN_READINGS=100
SENSOR_RETENTION_DAYS=31
# A device with no reading for this long is shown as Offline
DEVICE_OFFLINE_SECONDS=120

CORS_ORIGIN=http://tempse.local:5174



# ============================================================
# MQTT Broker
# ============================================================

MQTT_HOST=broker
MQTT_PORT=1883

MQTT_TOPIC=Test sensor/+

MQTT_USERNAME=changeme
MQTT_PASSWORD=changeme


# ============================================================
# LINE Messaging API (alert notifications)
# ============================================================

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

ALERT_HYSTERESIS=0.5
ALERT_CHECK_SECONDS=60
# Timezone used for times inside LINE messages
ALERT_TIMEZONE=Asia/Bangkok
# Temporary failures (network, 429, 5xx) retry with backoff:
# LINE_RETRY_BASE_SECONDS, then x2 each attempt, up to LINE_MAX_ATTEMPTS
LINE_MAX_ATTEMPTS=5
LINE_RETRY_BASE_SECONDS=30

# Google sign-in (optional; button hidden until both are set)
PUBLIC_URL=https://tempse.tail2afb95.ts.net
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated, e.g. cmu.ac.th. Empty = any Google account (still needs approval)
GOOGLE_ALLOWED_DOMAINS=
